#pragma kernel ClearWave
#pragma kernel TransportWave
#pragma kernel BuildBaseFlow
#pragma kernel ClearBoatFlow
#pragma kernel EmitBoatFlow
#pragma kernel ComposeFinalFlow
#pragma kernel AdvanceFoam
#pragma kernel ClearFoam
#pragma kernel EmitWake
#pragma kernel BakeLightArea
#include "OceanLightArea.hlsl"
RWTexture2D<float4> _LightPatternWrite;

float4 _WakeStart;
float4 _WakeEnd;
float4 _WakeStartEdges[16], _WakeEndEdges[16];
int _WakeEdgeCount;
float _WakeTravel;
float4 _WakeStrengths[4];
float4 _WakeStartRadii[4], _WakeEndRadii[4];

Texture2D<float4> _LowResolutionData;
Texture2D<float4> _BaseFlowRead;
Texture2D<float4> _BoatFlowRead;
Texture2D<float4> _FinalFlowRead;
Texture2D<float4> _FoamRead;
float4 _InteractorEdges[8];
float _InteractorRadius;
int _InteractorClosed;

RWTexture2D<float4> _BaseFlowWrite;
RWTexture2D<float4> _BoatFlowWrite;
RWTexture2D<float4> _FinalFlowWrite;
RWTexture2D<float4> _FoamWrite;

int2 _DataResolution;
float2 _DataOrigin;
float _TileWorldSize;
int2 _FieldResolution;
float2 _FieldOrigin;
float2 _FieldWorldSize;
int _NoiseSeed;
float _NoiseFrequency;
float _DeltaTime;
float _FoamDecay;

int2 _ShipDispatchOffset;
int2 _ShipDispatchSize;
int _InteractorEdgeCount;
float2 _ShipPosition;
float2 _ShipVelocity;
float _ShipAngularVelocity;
float _ShipRadius;
float _ShipInnerRadius;
float _SideFlowGain;
float _ShipFlowStrength;
float _ShipFoamEmission;
float _OceanTime;

bool ValidPixel(int2 p)
{
    return p.x >= 0 && p.y >= 0 && p.x < _FieldResolution.x && p.y < _FieldResolution.y;
}

float2 PixelWorld(int2 p)
{
    return _FieldOrigin + ((float2(p) + 0.5) / float2(_FieldResolution)) * _FieldWorldSize;
}

float4 CoarseCell(int2 p)
{
    p = clamp(p, int2(0, 0), _DataResolution - 1);
    float4 cell = _LowResolutionData.Load(int3(p, 0));
    cell.xy *= max(0.0, cell.z);
    return cell;
}

float4 InterpolateCoarse(float2 world)
{
    float2 grid = (world - _DataOrigin) / _TileWorldSize - 0.5;
    int2 i = int2(floor(grid));
    float2 u = frac(grid);
    float4 a = lerp(CoarseCell(i), CoarseCell(i + int2(1, 0)), u.x);
    float4 b = lerp(CoarseCell(i + int2(0, 1)), CoarseCell(i + int2(1, 1)), u.x);
    return lerp(a, b, u.y);
}

uint HashUInt(uint v)
{
    v ^= v >> 16;
    v *= 0x7feb352du;
    v ^= v >> 15;
    v *= 0x846ca68bu;
    v ^= v >> 16;
    return v;
}

float HashCell(int2 p, uint salt)
{
    uint n = asuint(p.x) * 0x9e3779b9u ^ asuint(p.y) * 0x85ebca6bu ^ salt;
    return (HashUInt(n) & 0x00ffffffu) / 16777215.0;
}

float ValueNoise(float2 p, uint salt)
{
    int2 cell = int2(floor(p));
    float2 uv = frac(p);
    uv = uv * uv * (3.0 - 2.0 * uv);
    float a = lerp(HashCell(cell, salt), HashCell(cell + int2(1, 0), salt), uv.x);
    float b = lerp(HashCell(cell + int2(0, 1), salt),
        HashCell(cell + int2(1, 1), salt), uv.x);
    return lerp(a, b, uv.y);
}

float2 StableNoise(float2 world)
{
    float2 p = world * _NoiseFrequency;
    uint seed = asuint(_NoiseSeed);
    return float2(ValueNoise(p, seed ^ 0x12a09f31u),
        ValueNoise(p, seed ^ 0x5fac9e7bu)) * 2.0 - 1.0;
}

float2 BaseVelocity(float2 world)
{
    float4 sample = InterpolateCoarse(world);
    return sample.xy + StableNoise(world) * max(0.0, sample.w) * max(0.0, sample.z);
}

float4 BaseCellAt(int2 p)
{
    return _BaseFlowRead.Load(int3(clamp(p, int2(0, 0), _FieldResolution - 1), 0));
}

float FoamAt(int2 p)
{
    return _FoamRead.Load(int3(clamp(p, int2(0, 0), _FieldResolution - 1), 0)).r;
}

float SampleFoamBilinear(float2 world)
{
    float2 uv = (world - _FieldOrigin) / _FieldWorldSize;
    float2 p = uv * float2(_FieldResolution) - 0.5;
    int2 i = int2(floor(p));
    float2 f = frac(p);
    float x0 = lerp(FoamAt(i), FoamAt(i + int2(1, 0)), f.x);
    float x1 = lerp(FoamAt(i + int2(0, 1)), FoamAt(i + int2(1, 1)), f.x);
    return lerp(x0, x1, f.y);
}

[numthreads(8, 8, 1)]
void BuildBaseFlow(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!ValidPixel(p)) return;
    float2 v = BaseVelocity(PixelWorld(p));
    _BaseFlowWrite[p] = float4(v.x, v.y, length(v), 0.0);
}

[numthreads(8, 8, 1)]
void ClearBoatFlow(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!ValidPixel(p)) return;
    _BoatFlowWrite[p] = 0.0;
}

[numthreads(8, 8, 1)]
void EmitBoatFlow(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ShipDispatchSize.x || id.y >= (uint)_ShipDispatchSize.y) return;
    int2 p = int2(id.xy) + _ShipDispatchOffset;
    if (!ValidPixel(p) || _InteractorEdgeCount < 1) return;

    float2 world = PixelWorld(p);
    float smallestDistanceSq = 3.402823e+38;
    float2 closest = 0.0;
    float2 chosenEdge = float2(0.0, 1.0);
    float signedAreaTwice = 0.0;
    bool insideHull = false;

    [loop]
    for (int i = 0; i < _InteractorEdgeCount; i++)
    {
        float2 a = _InteractorEdges[i].xy;
        float2 b = _InteractorEdges[i].zw;
        float2 e = b - a;
        signedAreaTwice += a.x * b.y - a.y * b.x;
        if (_InteractorClosed != 0 && ((a.y > world.y) != (b.y > world.y)))
        {
            float intersectX = a.x + (world.y - a.y) * (b.x - a.x) / (b.y - a.y);
            if (world.x < intersectX) insideHull = !insideHull;
        }
        float t = saturate(dot(world - a, e) / max(dot(e, e), 0.000001));
        float2 edgePoint = a + t * e;
        float distanceSq = dot(world - edgePoint, world - edgePoint);
        if (distanceSq < smallestDistanceSq)
        {
            smallestDistanceSq = distanceSq;
            closest = edgePoint;
            chosenEdge = e;
        }
    }

    float axisDistance = sqrt(smallestDistanceSq);
    float distanceToHull = axisDistance - _InteractorRadius;
    if (insideHull || distanceToHull < 0 || distanceToHull >= _ShipRadius) return;

    float winding = signedAreaTwice >= 0.0 ? 1.0 : -1.0;
    float2 tangent = chosenEdge * rsqrt(max(dot(chosenEdge, chosenEdge), 1e-8));
    float2 outward = float2(tangent.y, -tangent.x) * winding;
    // Outside a vertex, use the direction of the nearest point instead of an arbitrary edge.
    if (axisDistance > 0.00001)
        outward = (world - closest) / axisDistance;
    closest += outward * _InteractorRadius;

    float2 localOffset = closest - _ShipPosition;
    float2 shipPointVelocity = _ShipVelocity +
        _ShipAngularVelocity * float2(-localOffset.y, localOffset.x);
    float2 relativeWaterVelocity = BaseCellAt(p).xy - shipPointVelocity;

    float frontalImpact = max(0.0, -dot(relativeWaterVelocity, outward));
    float2 alongHull = relativeWaterVelocity - outward * dot(relativeWaterVelocity, outward);
    // The tangential component follows the relative water motion in either direction.
    float innerRadius = clamp(_ShipInnerRadius, 0.0, _ShipRadius - 0.001);
    float transition = saturate((distanceToHull - innerRadius) / max(_ShipRadius - innerRadius, 0.001));
    float influence = 0.5 + 0.5 * cos(3.14159265 * transition);

    float2 delta = _ShipFlowStrength * influence * (outward * frontalImpact +
        alongHull * _SideFlowGain);
    // World-stable clusters: never reseed per frame. Only this narrow band
    // emits; the broad boat influence remains exclusively wave/drift data.
    float foamBand = 1.0 - smoothstep(0.0, max(0.01, min(_ShipRadius, 2.0)), distanceToHull);
    float pattern = ValueNoise(world * 0.65, 0x75a31u);
    float clusters = smoothstep(0.58, 0.82, pattern);
    // Smooth, staggered emission packets keep a stationary emitter from
    // drawing an uninterrupted stripe into the advected history.
    float packet = smoothstep(0.15, 0.8, sin(_OceanTime * 2.5 + pattern * 12.0));
    float foamSource = foamBand * clusters * packet * min(1.2, _ShipFoamEmission *
        (frontalImpact + length(alongHull) * 0.3));

    float4 previous = _BoatFlowWrite[p];
    _BoatFlowWrite[p] = float4(previous.r, previous.g + foamSource, previous.ba + delta);
}

void ClosestWakeEdge(float2 world, float3 a, float3 b, inout float2 closest)
{
    float2 edge = b.xy - a.xy;
    float t = saturate(dot(world - a.xy, edge) / max(dot(edge, edge), 0.000001));
    float2 offset = world - lerp(a.xy, b.xy, t);
    float distanceSq = dot(offset, offset);
    if (distanceSq < closest.x)
        closest = float2(distanceSq, lerp(a.z, b.z, t));
}

void ClosestWakeTriangle(float2 world, float3 a, float3 b, float3 c, inout float2 closest)
{
    float2 u = b.xy - a.xy, v = c.xy - a.xy, p = world - a.xy;
    float area = u.x * v.y - u.y * v.x;
    if (abs(area) > 0.000001)
    {
        float s = (p.x * v.y - p.y * v.x) / area;
        float t = (u.x * p.y - u.y * p.x) / area;
        if (s >= 0 && t >= 0 && s + t <= 1)
        {
            closest = float2(0, a.z + s * (b.z - a.z) + t * (c.z - a.z));
            return;
        }
    }
    ClosestWakeEdge(world, a, b, closest);
    ClosestWakeEdge(world, b, c, closest);
    ClosestWakeEdge(world, c, a, closest);
}

void ClosestWakeStrip(float2 world, float2 startA, float2 startB, float2 endA, float2 endB,
    inout float2 closest)
{
    float3 a = float3(startA, _WakeStart.z), b = float3(startB, _WakeStart.z);
    float3 c = float3(endA, _WakeEnd.z), d = float3(endB, _WakeEnd.z);
    ClosestWakeTriangle(world, a, b, c, closest);
    ClosestWakeTriangle(world, c, b, d, closest);
}

[numthreads(8, 8, 1)]
void EmitWake(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ShipDispatchSize.x || id.y >= (uint)_ShipDispatchSize.y) return;
    int2 p = int2(id.xy) + _ShipDispatchOffset;
    float2 world = PixelWorld(p);
    float2 closest = float2(3.402823e+38, 0);
    float strength = 0;
    [loop]
    for (int edge = 0; edge < _WakeEdgeCount; edge++)
    {
        float4 start = _WakeStartEdges[edge], end = _WakeEndEdges[edge];
        float edgeStrength = _WakeStrengths[edge / 4][edge % 4];
        if (edgeStrength <= 0) continue;
        float2 candidate = float2(3.402823e+38, 0);
        ClosestWakeStrip(world, start.xy, start.zw, end.xy, end.zw, candidate);
        float alongTime = saturate((_WakeStart.z - candidate.y) / max(_WakeStart.z - _WakeEnd.z, 0.000001));
        float radius = lerp(_WakeStartRadii[edge / 4][edge % 4],
            _WakeEndRadii[edge / 4][edge % 4], alongTime);
        float distance = max(0.0, sqrt(candidate.x) - radius);
        candidate.x = distance * distance;
        if (candidate.x < closest.x)
        {
            closest = candidate;
            strength = edgeStrength;
        }
    }
    float age = closest.y;
    if (age >= 8.0) return;
    float distance = sqrt(closest.x);
    float width = 2.0 + age * 0.6;
    float envelope = 0.5 + 0.5 * cos(3.14159265 * saturate(distance / width));
    float lifetime = 1.0 - smoothstep(0.0, 8.0, age);
    float onset = smoothstep(0.0, 0.5, age);
    // Length weighting prevents frame rate / sampling density from increasing energy.
    float weight = min(_WakeTravel / max(width, 0.001), 1.0);
    float influence = _WakeStart.w * strength * weight * envelope * lifetime * onset;
    if (influence <= 0.0) return;
    float height = influence *
        sin(6.2831853 * (distance - age * 0.6) / max(_WakeEnd.w, 0.1));
    float4 value = _BoatFlowWrite[p];
    value.r += height;
    _BoatFlowWrite[p] = value;
}

[numthreads(8, 8, 1)]
void ComposeFinalFlow(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!ValidPixel(p)) return;
    float4 baseValue = _BaseFlowRead.Load(int3(p, 0));
    float4 deltaValue = _BoatFlowRead.Load(int3(p, 0));
    float2 result = baseValue.xy + deltaValue.ba;
    _FinalFlowWrite[p] = float4(result, length(result), 0);
}

[numthreads(8, 8, 1)]
void AdvanceFoam(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!ValidPixel(p)) return;
    float2 world = PixelWorld(p);
    float2 velocity = _FinalFlowRead.Load(int3(p, 0)).xy;
    float source = _BoatFlowRead.Load(int3(p, 0)).g;
    float previous = SampleFoamBilinear(world - velocity * _DeltaTime);
    float density = previous * exp(-_FoamDecay * _DeltaTime) + source * _DeltaTime;
    _FoamWrite[p] = float4(saturate(density), 0.0, 0.0, 0.0);
}

[numthreads(8, 8, 1)]
void ClearFoam(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!ValidPixel(p)) return;
    _FoamWrite[p] = 0.0;
}

Texture2D<float4> _WaveRead;
SamplerState sampler_WaveRead;
RWTexture2D<float4> _WaveWrite;
float _WaveStep;
float _WaveFlowResponse;
int _WaveReset;

[numthreads(8,8,1)]
void ClearWave(uint3 id : SV_DispatchThreadID)
{
    if (ValidPixel(int2(id.xy))) _WaveWrite[id.xy]=0;
}

[numthreads(8,8,1)]
void TransportWave(uint3 id : SV_DispatchThreadID)
{
    int2 p=int2(id.xy);
    if (!ValidPixel(p)) return;
    float2 v=_FinalFlowRead.Load(int3(p,0)).xy;
    float2 travel=v*(_WaveFlowResponse*_WaveStep);
    float2 uv=(PixelWorld(p)-travel-_FieldOrigin)/_FieldWorldSize;
    float4 offset=_WaveRead.SampleLevel(sampler_WaveRead,saturate(uv),0)-travel.xyxy;
    if (_WaveReset==1) offset.xy=0;
    if (_WaveReset==2) offset.zw=0;
    _WaveWrite[p]=offset;
}

[numthreads(8,8,1)]
void BakeLightArea(uint3 id : SV_DispatchThreadID)
{
    if(any(id.xy>=512)) return;
    float2 p=(id.xy+.5)*(16.0/512);
    // Periodic warp at cell scale and below, baked once into the pattern.
    float2 phase=p*(6.28318530718/16.0);
    float2 q=p+.17*float2(sin(dot(phase,float2(3,9))),
                          sin(dot(phase,float2(8,-4))))
              +.055*float2(sin(dot(phase,float2(11,-13))),
                           sin(dot(phase,float2(14,9))));
    float2 cell=floor(q), nearestPoint=0;
    float best=100;
    [loop] for(int y=-2;y<=2;y++)
    [loop] for(int x=-2;x<=2;x++)
    {
        float2 key=cell+float2(x,y), wrapped=key-floor(key/16)*16;
        float2 center=key+.5+(LightHash(wrapped)-.5)*.9;
        float d=dot(q-center,q-center);
        if(d<best) { best=d; nearestPoint=center; }
    }
    float edge=100, secondEdge=100;
    [loop] for(int y=-2;y<=2;y++)
    [loop] for(int x=-2;x<=2;x++)
    {
        float2 key=cell+float2(x,y), wrapped=key-floor(key/16)*16;
        float2 center=key+.5+(LightHash(wrapped)-.5)*.9;
        float2 delta=center-nearestPoint;
        if(dot(delta,delta)<.0001) continue;
        float distanceToEdge=max(0,dot((center+nearestPoint)*.5-q,normalize(delta)));
        if(distanceToEdge<edge) {secondEdge=edge;edge=distanceToEdge;}
        else secondEdge=min(secondEdge,distanceToEdge);
    }
    float junction=1+.95*(1-smoothstep(.015,.19,secondEdge));
    float width=.73+.17*sin(dot(phase,float2(5,7)))*cos(dot(phase,float2(8,-3)));
    _LightPatternWrite[id.xy]=float4(edge,junction,width,1);
}
